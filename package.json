{
  "name": "persona-chat",
  "productName": "Persona Chat",
  "version": "0.2.1",
  "description": "카카오톡·인스타그램·디스코드 대화로 지인 페르소나 챗봇 만들기",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test.mjs",
    "dist": "electron-builder --win portable",
    "dist:setup": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "icon": "electron scripts/render-icon.js"
  },
  "build": {
    "appId": "local.persona-chat",
    "files": [
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Persona-Chat-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Persona-Chat-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "artifactName": "Persona-Chat-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Chat",
      "artifactName": "Persona-Chat-${version}-linux-${arch}.${ext}"
    },
    "directories": {
      "output": "dist/${version}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@google/genai": "2.24.0",
    "fflate": "0.7.5",
    "openai": "7.23.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "homepage": "https://github.com/vector2967/persona-chat",
  "author": {
    "name": "vector2967",
    "email": "63567632+vector2967@users.noreply.github.com"
  }
}
